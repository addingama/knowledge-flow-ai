{
  "name": "knowledge-flow-ai",
  "version": "1.0.0",
  "description": "My knowledge flow to learn and grow",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r --sort build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @repo/shared build && pnpm -r --if-present test",
    "test:coverage": "pnpm --filter @repo/shared build && pnpm --filter @repo/api test:coverage",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.16.1"
}
